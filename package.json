{
  "name": "pdf-translator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "format": "pnpm oxfmt --write \"**/*.{js,mjs,ts,mts,d.ts,html}\"",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/pwa": "^22.2.5",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@likecoin/epub-ts": "^0.7.3",
    "ngx-extended-pdf-viewer": "31.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
